# /etc/systemd/system/callagent.service   (non-Docker deployment)
# sudo systemctl daemon-reload && sudo systemctl enable --now callagent
[Unit]
Description=hanuman.ai Call Platform
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/nepal-call-agent
EnvironmentFile=/opt/nepal-call-agent/.env
ExecStart=/opt/nepal-call-agent/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
