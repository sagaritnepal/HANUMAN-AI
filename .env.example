# === Required ===
ANTHROPIC_API_KEY=sk-ant-...             # console.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5-20251001   # Haiku = low cost/call; upgrade per-tenant if needed
ADMIN_API_KEY=change-me-to-a-long-random-string   # protects /admin endpoints

# === Company / agent identity ===
COMPANY_NAME=Your Company Pvt. Ltd.
AGENT_NAME=Asha
DEFAULT_LANGUAGE=auto               # auto | ne | en  (auto = match the caller)

# === Telephony (fill in whichever provider you use) ===
# Twilio path:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL of this server (Twilio must reach it). e.g. https://calls.yourdomain.com.np
PUBLIC_BASE_URL=

# === Speech ===
WHISPER_MODEL=small                 # tiny|base|small|medium — small is fine on 4GB VPS
TTS_VOICE=en_US-amy-medium          # piper voice; see README for Nepali options

# === Storage ===
LEADS_DB_PATH=./leads.db
